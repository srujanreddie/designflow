// This is the Prisma schema for DesignFlow
// Learn more at: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User & Authentication
// ============================================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  name          String
  passwordHash  String
  avatarUrl     String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  documents     Document[]
  assets        Asset[]
  shares        DocumentShare[]   @relation("SharedWith")
  sharedBy      DocumentShare[]   @relation("SharedBy")
  comments      Comment[]
  activities    Activity[]
  revisions     DocumentRevision[]

  @@index([email])
}

enum UserRole {
  USER
  ADMIN
}

// ============================================================
// Design Documents
// ============================================================

model Document {
  id            String    @id @default(uuid())
  title         String    @default("Untitled Design")
  width         Int
  height        Int
  unit          String    @default("px")
  content       Json      // The full DesignDocument JSON
  schemaVersion Int       @default(1)
  version       Int       @default(0)
  thumbnailUrl  String?
  
  // Template fields
  isTemplate    Boolean   @default(false)
  templateCategory String?
  templateTags  String[]
  templateDescription String?
  isPremium     Boolean   @default(false)
  usageCount    Int       @default(0)
  
  // Ownership
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  // Status
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  lastOpenedAt  DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  shares        DocumentShare[]
  revisions     DocumentRevision[]
  comments      Comment[]
  activities    Activity[]

  @@index([ownerId])
  @@index([isTemplate, templateCategory])
  @@index([isDeleted])
  @@index([updatedAt])
}

// ============================================================
// Document Sharing & Permissions
// ============================================================

model DocumentShare {
  id            String     @id @default(uuid())
  documentId    String
  document      Document   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Who it's shared with
  userId        String?    // null if shared via email to unregistered user
  user          User?      @relation("SharedWith", fields: [userId], references: [id])
  email         String     // email of the invitee
  
  // Who shared it
  sharedById    String
  sharedBy      User       @relation("SharedBy", fields: [sharedById], references: [id])
  
  permission    Permission @default(VIEWER)
  
  // Share link
  shareToken    String?    @unique
  isPublicLink  Boolean    @default(false)
  
  acceptedAt    DateTime?
  expiresAt     DateTime?
  revokedAt     DateTime?
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([documentId, email])
  @@index([documentId])
  @@index([userId])
  @@index([shareToken])
}

enum Permission {
  VIEWER
  COMMENTER
  EDITOR
  OWNER
}

// ============================================================
// Document Version History
// ============================================================

model DocumentRevision {
  id            String    @id @default(uuid())
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  version       Int
  content       Json      // Snapshot of the document at this version
  description   String?
  
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  
  createdAt     DateTime  @default(now())

  @@unique([documentId, version])
  @@index([documentId, createdAt])
}

// ============================================================
// Assets (Uploaded Files)
// ============================================================

model Asset {
  id            String    @id @default(uuid())
  name          String
  type          AssetType
  mimeType      String
  url           String
  thumbnailUrl  String?
  fileSize      Int       // bytes
  width         Int?
  height        Int?
  
  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([ownerId])
  @@index([type])
  @@index([isDeleted])
}

enum AssetType {
  IMAGE
  SVG
  FONT
  VIDEO
}

// ============================================================
// Comments
// ============================================================

model Comment {
  id            String    @id @default(uuid())
  documentId    String
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  pageId        String
  
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  
  content       String
  positionX     Float
  positionY     Float
  resolved      Boolean   @default(false)
  
  parentId      String?   // For replies
  parent        Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies       Comment[] @relation("CommentReplies")
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([documentId])
  @@index([parentId])
}

// ============================================================
// Activity Log
// ============================================================

model Activity {
  id            String       @id @default(uuid())
  documentId    String?
  document      Document?    @relation(fields: [documentId], references: [id], onDelete: SetNull)
  
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  
  action        ActivityAction
  metadata      Json?
  
  createdAt     DateTime     @default(now())

  @@index([documentId])
  @@index([userId])
  @@index([createdAt])
}

enum ActivityAction {
  DOCUMENT_CREATED
  DOCUMENT_UPDATED
  DOCUMENT_DELETED
  DOCUMENT_SHARED
  DOCUMENT_EXPORTED
  DOCUMENT_RESTORED
  COMMENT_ADDED
  COMMENT_RESOLVED
  COLLABORATOR_JOINED
  ASSET_UPLOADED
  TEMPLATE_USED
}

// ============================================================
// Design Bundles & External Catalog Importer Models
// ============================================================

model SourceCatalog {
  id          String          @id @default(uuid())
  slug        String          @unique
  name        String
  sourceUrl   String
  description String?
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  products    SourceProduct[]
  importJobs  ImportJob[]
}

model SourceProduct {
  id                String            @id @default(uuid())
  catalogId         String
  catalog           SourceCatalog     @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  sourceId          String            // Unique ID on external catalog e.g. "db-4091"
  title             String
  slug              String
  sourceUrl         String
  category          String
  subcategory       String?
  authorName        String?
  description       String?
  price             Float?
  currency          String            @default("USD")
  previewImages     String[]          // Array of preview image URLs
  productType       String            // e.g. "Canva Template", "Vector Bundle"
  fileFormats       String[]          // e.g. ["CANVA", "PDF", "PNG", "SVG"]
  dimensions        String?           // e.g. "1080x1080 px"
  pageCount         Int               @default(1)
  tags              String[]
  licenseType       String            @default("Commercial / Standard")
  attributionRequired Boolean         @default(false)
  importStatus      ProductImportStatus @default(DISCOVERED)
  verificationStatus AssetVerificationStatus @default(PENDING)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  importedTemplate  CatalogTemplate?

  @@unique([catalogId, sourceId])
  @@index([catalogId, category])
  @@index([importStatus])
}

enum ProductImportStatus {
  DISCOVERED
  METADATA_EXTRACTED
  ASSETS_DOWNLOADING
  IMPORT_COMPLETED
  LICENSE_RESTRICTED
  CONVERSION_FAILED
}

enum AssetVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  RESTRICTED
}

model CatalogTemplate {
  id                String          @id @default(uuid())
  sourceProductId   String?         @unique
  sourceProduct     SourceProduct?  @relation(fields: [sourceProductId], references: [id], onDelete: SetNull)
  title             String
  slug              String          @unique
  category          String
  width             Int
  height            Int
  unit              String          @default("px")
  isEditable        Boolean         @default(true)
  documentContent   Json            // Structured DesignFlow DesignDocument JSON
  previewThumbnail  String
  colorPalette      String[]        // Hex colors
  primaryFont       String?
  downloadUrl       String?
  downloadAllowed   Boolean         @default(true)
  usageCount        Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([category])
  @@index([isEditable])
}

model FontFamily {
  id            String        @id @default(uuid())
  family        String        @unique
  category      String?       // "sans-serif", "serif", "display", "handwriting", "monospace"
  license       String        @default("Open Font License")
  source        String?       // "Google Fonts", "DesignBundles", "System"
  isImported    Boolean       @default(false)
  isAvailable   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  variants      FontVariant[]
}

model FontVariant {
  id            String        @id @default(uuid())
  fontFamilyId  String
  fontFamily    FontFamily    @relation(fields: [fontFamilyId], references: [id], onDelete: Cascade)
  weight        String        // "400", "700", etc.
  style         String        @default("normal") // "normal", "italic"
  format        String        // "woff2", "woff", "ttf", "otf"
  fileUrl       String?
  fileSize      Int?
  checksum      String?
  createdAt     DateTime      @default(now())
}

model ImportJob {
  id              String            @id @default(uuid())
  catalogId       String
  catalog         SourceCatalog     @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  status          JobStatus         @default(PENDING)
  totalDiscovered Int               @default(0)
  totalProcessed  Int               @default(0)
  totalSuccessful Int               @default(0)
  totalFailed     Int               @default(0)
  totalRestricted Int               @default(0)
  checkpointCursor String?
  errorMessage    String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  items           ImportJobItem[]

  @@index([catalogId, status])
}

enum JobStatus {
  PENDING
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  CANCELLED
}

model ImportJobItem {
  id            String          @id @default(uuid())
  jobId         String
  job           ImportJob       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourceId      String
  sourceUrl     String
  status        JobItemStatus   @default(QUEUED)
  attempts      Int             @default(0)
  errorMessage  String?
  processedAt   DateTime?
  createdAt     DateTime        @default(now())

  @@index([jobId, status])
}

enum JobItemStatus {
  QUEUED
  IN_PROGRESS
  SUCCESS
  FAILED
  SKIPPED
  LICENSE_RESTRICTED
}
